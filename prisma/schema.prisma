generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum type, so enums below are represented as
// validated strings (see src/lib/enums.ts for the canonical value lists).
// Role: ADMIN | LEARNER
// CourseLevel: BEGINNER | INTERMEDIATE | ADVANCED
// CourseFormat: ONLINE_LIVE | SELF_PACED | HYBRID
// CourseStatus: DRAFT | PUBLISHED | FULLY_BOOKED | INACTIVE | ARCHIVED
// ScheduleStatus: OPEN | FULL | CANCELLED
// BookingStatus: PENDING | CONFIRMED | CANCELLED | COMPLETED
// PaymentStatus: UNPAID | PENDING | PAID | REFUNDED | FAILED
// ContactMethod: EMAIL | PHONE | WHATSAPP

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("LEARNER")
  phone        String?
  country      String?
  createdAt    DateTime  @default(now())
  bookings     Booking[]
}

model Instructor {
  id              String   @id @default(cuid())
  fullName        String
  slug            String   @unique
  photoUrl        String?
  title           String
  qualifications  String
  certifications  String?
  experienceYears Int      @default(0)
  bio             String
  specialization  String
  languages       String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  courses  Course[]
  bookings Booking[]
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  courses Course[]
}

model Course {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  code          String   @unique
  description   String
  objectives    String
  imageUrl      String?
  level         String   @default("BEGINNER")
  format        String   @default("ONLINE_LIVE")
  durationHours Float
  sessionsCount Int      @default(1)
  hourlyRate    Float
  maxLearners   Int      @default(20)
  status        String   @default("DRAFT")
  currency      String   @default("OMR")
  categoryId    String
  instructorId  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id])
  instructor Instructor       @relation(fields: [instructorId], references: [id])
  modules    CourseModule[]
  schedules  CourseSchedule[]
  bookings   Booking[]
  reviews    Review[]

  @@index([categoryId])
  @@index([instructorId])
}

model CourseModule {
  id          String @id @default(cuid())
  courseId    String
  order       Int
  title       String
  description String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model CourseSchedule {
  id          String   @id @default(cuid())
  courseId    String
  date        DateTime
  startTime   String
  endTime     String
  capacity    Int
  seatsBooked Int      @default(0)
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([courseId])
}

model Booking {
  id           String  @id @default(cuid())
  courseId     String
  scheduleId   String
  instructorId String
  userId       String?

  learnerName      String
  learnerEmail     String
  learnerPhone     String
  country          String
  preferredContact String  @default("EMAIL")
  notes            String?

  // Historical price snapshot -- must never change after creation, even if
  // the course's hourly rate changes later.
  hourlyRateSnapshot    Float
  durationHoursSnapshot Float
  totalPriceSnapshot    Float
  currencySnapshot      String @default("OMR")

  status        String @default("PENDING")
  paymentStatus String @default("UNPAID")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course     Course         @relation(fields: [courseId], references: [id])
  schedule   CourseSchedule @relation(fields: [scheduleId], references: [id])
  instructor Instructor     @relation(fields: [instructorId], references: [id])
  user       User?          @relation(fields: [userId], references: [id])

  @@index([courseId])
  @@index([scheduleId])
  @@index([status])
}

model Review {
  id          String   @id @default(cuid())
  courseId    String
  learnerName String
  rating      Int
  comment     String
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model PlatformSettings {
  id                    String   @id @default(cuid())
  platformName          String   @default("EduSphere")
  logoUrl               String?
  contactEmail          String   @default("hello@edusphere.om")
  contactPhone          String   @default("+968 9000 0000")
  currency              String   @default("OMR")
  timezone              String   @default("Asia/Muscat")
  cancellationPolicy    String   @default("Cancellations made more than 48 hours before the session start are eligible for a full refund.")
  minBookingNoticeHours Int      @default(24)
  maxBookingPeriodDays  Int      @default(180)
  updatedAt             DateTime @updatedAt
}
