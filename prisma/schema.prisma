generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums are kept as plain strings (rather than native Prisma enums) so this
// schema stays portable across providers; see src/lib/enums.ts for the
// canonical value lists.
// Role: ADMIN | LEARNER
// CourseLevel: BEGINNER | INTERMEDIATE | ADVANCED
// CourseFormat: ONLINE_LIVE | SELF_PACED | HYBRID
// CourseStatus: DRAFT | PUBLISHED | FULLY_BOOKED | INACTIVE | ARCHIVED
// ScheduleStatus: OPEN | FULL | CANCELLED
// BookingStatus: PENDING | CONFIRMED | CANCELLED | COMPLETED
// PaymentStatus: UNPAID | PENDING | PAID | REFUNDED | FAILED
// ContactMethod: EMAIL | PHONE | WHATSAPP

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  role              String             @default("LEARNER")
  phone             String?
  country           String?
  locale            String             @default("ar")
  theme             String             @default("light")
  createdAt         DateTime           @default(now())
  bookings          Booking[]
  placementAttempts PlacementAttempt[]

  // Free English Lessons: the level the learner chose to study at.
  freeLessonLevel    String?
  freeLessonProgress FreeLessonProgress[]
  freeLessonAttempts FreeLessonAttempt[]
}

model Instructor {
  id              String   @id @default(cuid())
  fullName        String
  slug            String   @unique
  photoUrl        String?
  title           String
  qualifications  String
  certifications  String?
  experienceYears Int      @default(0)
  bio             String
  specialization  String
  languages       String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  courses  Course[]
  bookings Booking[]
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  courses Course[]
}

model Course {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  code          String   @unique
  description   String
  objectives    String
  imageUrl      String?
  level         String   @default("BEGINNER")
  format        String   @default("ONLINE_LIVE")
  durationHours Float
  sessionsCount Int      @default(1)
  hourlyRate    Float
  maxLearners   Int      @default(20)
  status        String   @default("DRAFT")
  currency      String   @default("OMR")
  categoryId    String
  instructorId  String

  // Optional time-limited discount. discountType: NONE | PERCENT | AMOUNT
  // (AMOUNT = a fixed amount off the total course price). The offer stops
  // applying automatically once discountEndsAt has passed.
  discountType    String    @default("NONE")
  discountValue   Float     @default(0)
  discountEndsAt  DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id])
  instructor Instructor       @relation(fields: [instructorId], references: [id])
  modules    CourseModule[]
  schedules  CourseSchedule[]
  bookings   Booking[]
  reviews    Review[]

  @@index([categoryId])
  @@index([instructorId])
}

model CourseModule {
  id          String @id @default(cuid())
  courseId    String
  order       Int
  title       String
  description String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model CourseSchedule {
  id          String   @id @default(cuid())
  courseId    String
  date        DateTime
  startTime   String
  endTime     String
  capacity    Int
  seatsBooked Int      @default(0)
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([courseId])
}

model Booking {
  id               String  @id @default(cuid())
  bookingReference String? @unique
  courseId         String
  scheduleId       String
  instructorId     String
  userId           String?

  learnerName      String
  learnerEmail     String
  learnerPhone     String
  country          String
  preferredContact String  @default("EMAIL")
  notes            String?

  // Historical price snapshot -- must never change after creation, even if
  // the course's hourly rate changes later.
  hourlyRateSnapshot    Float
  durationHoursSnapshot Float
  totalPriceSnapshot    Float
  currencySnapshot      String @default("OMR")
  // Discount applied at booking time (amount off the original total). totalPriceSnapshot is the price actually charged.
  discountSnapshot      Float  @default(0)

  status        String @default("PENDING")
  paymentStatus String @default("UNPAID")

  // Payment receipt uploaded by the learner (image or PDF), stored inline
  // as a base64 data URL -- no external file storage service is
  // configured for this project, and receipts are small enough that a
  // Postgres TEXT column is a reasonable, dependency-free fit.
  receiptData       String?
  receiptFileName   String?
  receiptMimeType   String?
  receiptUploadedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course     Course         @relation(fields: [courseId], references: [id])
  schedule   CourseSchedule @relation(fields: [scheduleId], references: [id])
  instructor Instructor     @relation(fields: [instructorId], references: [id])
  user       User?          @relation(fields: [userId], references: [id])

  @@index([courseId])
  @@index([scheduleId])
  @@index([status])
}

model Review {
  id          String   @id @default(cuid())
  courseId    String
  learnerName String
  rating      Int
  comment     String
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model PlatformSettings {
  id                          String   @id @default(cuid())
  platformName                String   @default("EduSphere")
  logoUrl                     String?
  contactEmail                String   @default("hello@edusphere.om")
  contactPhone                String   @default("+968 9000 0000")
  currency                    String   @default("OMR")
  timezone                    String   @default("Asia/Muscat")
  cancellationPolicy          String   @default("Cancellations made more than 48 hours before the session start are eligible for a full refund.")
  minBookingNoticeHours       Int      @default(24)
  maxBookingPeriodDays        Int      @default(180)
  placementRetakeCooldownDays Int      @default(7)
  placementListeningReplays   Int      @default(2)
  updatedAt                   DateTime @updatedAt
}

// -----------------------------------------------------------------------
// English Placement Test
//
// CEFR: PRE_A1 | A1 | A2 | B1 | B2 | C1
// Skill: GRAMMAR | VOCABULARY | READING | LISTENING
// Difficulty: VERY_EASY | EASY | MEDIUM | DIFFICULT | VERY_DIFFICULT
// AttemptStatus: IN_PROGRESS | COMPLETED | ABANDONED
// -----------------------------------------------------------------------

model PlacementQuestion {
  id           String   @id @default(cuid())
  cefrLevel    String
  skill        String
  difficulty   String
  topic        String
  prompt       String
  // Array of option strings, e.g. ["go", "goes", "going", "gone"]
  options      String
  // Index (0-based) into `options` of the correct answer
  correctIndex Int
  explanation  String?
  audioText    String? // read aloud client-side via the Web Speech API
  imageUrl     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([cefrLevel])
  @@index([skill])
  @@index([active])
}

model PlacementVersion {
  id               String   @id @default(cuid())
  name             String   @unique // "A", "B", "C", "D", "E"
  active           Boolean  @default(true)
  timeLimitMinutes Int      @default(30)
  questionCount    Int      @default(30)
  cefrRangeMin     String   @default("PRE_A1")
  cefrRangeMax     String   @default("C1")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attempts PlacementAttempt[]
}

model PlacementAttempt {
  id        String  @id @default(cuid())
  versionId String
  userId    String?

  // Anonymous test-takers are fully supported -- no account required.
  learnerName  String?
  learnerEmail String?

  status              String @default("IN_PROGRESS")
  selectedQuestionIds String // JSON array, order = presentation order
  answers             String @default("{}") // JSON: { [questionId]: { selectedIndex, correct, timeMs } }
  currentIndex        Int    @default(0)

  scoreOverall          Int? // 0-100
  cefrOverall           String?
  cefrOverallLabel      String? // e.g. "Strong A2" / "A2 approaching B1"
  skillScores           String? // JSON: { grammar: "A2", vocabulary: "A2", reading: "B1", listening: "A2" }
  headwayRecommendation String?
  resultReference       String? @unique // e.g. EPR-2026-000123

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  version PlacementVersion @relation(fields: [versionId], references: [id])
  user    User?            @relation(fields: [userId], references: [id])

  @@index([versionId])
  @@index([userId])
  @@index([status])
}

// -----------------------------------------------------------------------
// Free English Lessons (mini-LMS)
//
// Level: BEGINNER | ELEMENTARY | PRE_INTERMEDIATE | INTERMEDIATE | UPPER_INTERMEDIATE | ADVANCED
// Category: GRAMMAR | VOCABULARY | WRITING | READING
// Difficulty: BASIC | CORE | CHALLENGING
// LessonStatus: DRAFT | PUBLISHED | UNPUBLISHED
// ProgressStatus: IN_PROGRESS | COMPLETED
// ExerciseType: MULTIPLE_CHOICE | MULTIPLE_SELECT | TRUE_FALSE | FILL_BLANK |
//               SHORT_ANSWER | ORDERING | MATCHING | IDENTIFY_MISTAKE
// -----------------------------------------------------------------------

model FreeLesson {
  id               String  @id @default(cuid())
  slug             String  @unique
  level            String
  category         String
  title            String
  topic            String
  difficulty       String  @default("CORE")
  order            Int     @default(0) // sequence within level + category
  estimatedMinutes Int     @default(10)
  objective        String
  imageUrl         String?
  status           String  @default("DRAFT")

  // Structured explanation content (JSON, validated by src/lib/free-lessons/schema.ts)
  content String @default("{\"sections\":[]}")

  // Recommendation metadata
  tags          String @default("[]") // JSON string[] -- placement weakness / topic tags
  prerequisites String @default("[]") // JSON string[] of lesson slugs

  // Completion rules (configurable per lesson)
  requireAllAnswered Boolean @default(true)
  minScorePercent    Int     @default(60)
  allowRetry         Boolean @default(true)

  // Internal curriculum alignment only -- never displayed to learners.
  refBook  String?
  refLevel String?
  refArea  String?
  refTopic String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises FreeLessonExercise[]
  progress  FreeLessonProgress[]
  attempts  FreeLessonAttempt[]

  @@index([level, category, order])
  @@index([status])
}

model FreeLessonExercise {
  id          String  @id @default(cuid())
  lessonId    String
  order       Int     @default(0)
  type        String
  prompt      String
  context     String? // optional passage / stimulus shown above the prompt
  data        String // JSON, shape depends on `type` (see schema.ts)
  explanation String?
  points      Int     @default(1)

  lesson FreeLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, order])
}

model FreeLessonProgress {
  id       String @id @default(cuid())
  userId   String
  lessonId String
  status   String @default("IN_PROGRESS")

  contentRead  Boolean @default(false)
  viewCount    Int     @default(1)
  // JSON: { [exerciseId]: { answer, correct, attempts } } -- persisted so
  // progress follows the learner across devices and sessions.
  results      String  @default("{}")
  scorePercent Int     @default(0)

  startedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson FreeLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@index([status])
}

// One row per answer submission -- feeds admin analytics (difficulty,
// common wrong answers). exerciseId is deliberately not a relation so
// analytics survive exercise edits.
model FreeLessonAttempt {
  id         String   @id @default(cuid())
  userId     String
  lessonId   String
  exerciseId String
  correct    Boolean
  answerText String
  createdAt  DateTime @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson FreeLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([exerciseId])
}
